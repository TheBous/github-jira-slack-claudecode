#!/bin/bash
# Approve PR and add confirmation comment
# Usage: ./approve-and-comment OWNER REPO PR_NUMBER

set -e

OWNER="$1"
REPO="$2"
PR_NUMBER="$3"

# Approve the PR
echo "Approving PR #$PR_NUMBER..."
gh pr review "$PR_NUMBER" --approve

# Post confirmation comment
echo "Posting confirmation comment..."

# Try via gh api first
if gh api repos/"$OWNER"/"$REPO"/issues/"$PR_NUMBER"/comments \
  -X POST -f body="All review comments resolved ✅" 2>/dev/null; then
  echo "✅ PR #$PR_NUMBER approved"
  echo "💬 Comment added: All review comments resolved ✅"
  exit 0
fi

# Fallback to curl
curl -sf -X POST \
  -H "Authorization: Bearer $(gh auth token)" \
  -H "Accept: application/vnd.github.v3+json" \
  "https://api.github.com/repos/$OWNER/$REPO/issues/$PR_NUMBER/comments" \
  -d '{"body":"All review comments resolved ✅"}' > /dev/null

echo "✅ PR #$PR_NUMBER approved"
echo "💬 Comment added: All review comments resolved ✅"
